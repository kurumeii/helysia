{
	"name": "helysia",
	"type": "module",
	"module": "./src/index.ts",
	"engines": {
		"bun": ">=1.4.4"
	},
	"scripts": {
		"dev": "bun run --parallel dev:server dev:css",
		"dev:server": "bun --watch src/index.ts",
		"dev:css": "bun run --bun tailwindcss -i ./src/shared/style/global.css -o ./public/global.css -w",
		"start": "NODE_ENV=production bun run ./src/index.ts",
		"test": "bun test",
		"build:css": "bun run --bun tailwindcss -i ./src/shared/style/global.css -o ./public/global.css ",
		"lint": "bun lint:code && bun lint:spell",
		"lint:code": "biome check --write src",
		"lint:spell": "cspell lint src",
		"generate": "drizzle-kit generate --config ./src/config/drizzle.config.ts",
		"push": "drizzle-kit push --config ./src/config/drizzle.config.ts",
		"migrate": "drizzle-kit migrate --config ./src/config/drizzle.config.ts",
		"studio": "drizzle-kit studio --config ./src/config/drizzle.config.ts",
		"seed": "bun run ./src/database/seed.ts"
	},
	"dependencies": {
		"@bogeychan/elysia-etag": "^0.1.0",
		"@elysiajs/bearer": "^1.4.4",
		"@elysiajs/cors": "^1.4.2",
		"@elysiajs/html": "^1.4.2",
		"@elysiajs/jwt": "^1.4.2",
		"@elysiajs/static": "^1.4.10",
		"@elysiajs/swagger": "^1.3.1",
		"drizzle-orm": "^0.45.4",
		"drizzle-typebox": "^0.3.3",
		"elysia": "^1.4.30",
		"elysia-autoload": "^1.7.0",
		"elysia-helmet": "^3.1.0",
		"env-var": "^7.5.0",
		"picocolors": "^1.1.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@tailwindcss/cli": "^4.3.4",
		"@types/bun": "^1.4.4",
		"cspell": "^10.4.0",
		"daisyui": "^5.7.50",
		"drizzle-kit": "^0.31.11",
		"drizzle-seed": "^0.3.1",
		"postgres": "^4.0.0",
		"tailwindcss": "^4.3.4",
		"typescript": "^7.0.2"
	},
	"trustedDependencies": [
		"@biomejs/biome",
		"@parcel/watcher"
	]
}
